# Almena Registry web configuration. `task init` copies this file to .env,
# which Next.js, Docker Compose and Task all read.

# Port published on the host by Docker Compose (the portal listens on 3000 inside).
REGISTRY_WEB_PORT=3000

# Public origin of the portal (canonical URL, Open Graph and other metadata).
NEXT_PUBLIC_REGISTRY_WEB_URL=https://registry.almena.id

# The API as the browser reaches it. NEXT_PUBLIC_* values are inlined
# into the bundle when building: rebuild (`task up`) after changing it.
# Against a local API (../api, `task dev`): http://localhost:8000
NEXT_PUBLIC_REGISTRY_API_URL=https://api.almena.id
# The catalog, where holders apply for credentials: old /credentials and
# /apply links here redirect to it.
REGISTRY_CATALOG_URL=https://catalog.almena.id

# The API as the Next.js server reaches it (server components, route
# handlers), read at runtime. Against a local API: http://localhost:8000
REGISTRY_API_URL=https://api.almena.id

# Directory with the origin's did-configuration.json, served at
# /.well-known/did-configuration.json (signed elsewhere with Almena's DID key).
# Empty serves none. Under `task up`, ./well-known is mounted.
REGISTRY_WEB_WELL_KNOWN_DIR=./well-known
