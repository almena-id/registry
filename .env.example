# Almena Registry web configuration. `task init` copies this file to .env,
# which Next.js, Docker Compose and Task all read.

# Port published on the host by Docker Compose (the portal listens on 3000 inside).
REGISTRY_WEB_PORT=3000

# The registry-api as the browser reaches it. NEXT_PUBLIC_* values are inlined
# into the bundle when building: rebuild (`task up`) after changing it.
NEXT_PUBLIC_REGISTRY_API_URL=http://localhost:8000

# The registry-api as the Next.js server reaches it (server components, route
# handlers), read at runtime. In Docker, the API published on the host.
REGISTRY_API_URL=http://localhost:8000

# The same, for the container started by `task up` (compose.yml): the API
# published on the host by ../registry-api.
REGISTRY_API_URL_DOCKER=http://host.docker.internal:8000
