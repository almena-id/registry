# Almena Registry web configuration. `task init` copies this file to .env,
# which Next.js, Docker Compose and Task all read.

# Port published on the host by Docker Compose (the portal listens on 3000 inside).
REGISTRY_WEB_PORT=3000

# Public origin of the portal (canonical URL, Open Graph and other metadata).
NEXT_PUBLIC_REGISTRY_WEB_URL=http://localhost:3000

# The API as the browser reaches it. NEXT_PUBLIC_* values are inlined
# into the bundle when building: rebuild (`task up`) after changing it.
# Against a local API (../api, `task dev`): http://localhost:8000
NEXT_PUBLIC_REGISTRY_API_URL=http://localhost:8000

# The API as the Next.js server reaches it (server components, route
# handlers), read at runtime.
REGISTRY_API_URL=http://localhost:8000
